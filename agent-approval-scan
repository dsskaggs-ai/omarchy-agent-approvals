#!/usr/bin/env bash
# agent-approval-scan — poll terminal agents and refresh their approval records.
#
# Called on a timer by the Omarchy bar widget. Two detectors, union'd:
#   1. herdr: any pane whose agent_status == "blocked"  (native detection)
#   2. tmux : any pane whose last N lines match an approval/permission prompt
#
# Records it owns: sources "herdr" and "tmux". It fully reconciles those two
# sources on every run (adds new, clears gone), and never touches records from
# other sources (hermes-*, claude-code, codex, manual).

set -u
export PATH="$HOME/.local/bin:$PATH"

STATE_DIR="${AGENT_APPROVAL_STATE_DIR:-$HOME/.local/state/omarchy/approvals}"
mkdir -p "$STATE_DIR"

# Serialize runs: the widget timer can fire while a slow run (herdr pane read
# per pane) is still going; overlapping runs clear records the other just added.
exec 9>"$STATE_DIR/.scan.lock"
flock -n 9 || exit 0

# Hard dependency of both detectors.
command -v jq >/dev/null 2>&1 || exit 0

# Prompts that mean "a human must answer before the agent continues".
# Kept deliberately narrow: shell prompts like "❯" alone do NOT match.
PROMPT_RE='(Do you want to (proceed|allow|run|continue|make this edit)|Allow (once|always|this)|Yes, (allow|proceed|I trust|I accept|and don.t ask)|Approve\?|Approve this|approval (required|needed)|needs? your (approval|permission|input)|Grant permission|Permission (required|request|needed)|\[y/N\]|\(y/n\)|Press Enter to (approve|continue|confirm)|Would you like to (proceed|continue|allow)|awaiting (your )?(approval|confirmation|input)|Waiting for (your )?(approval|permission|input)|requires (your )?(approval|confirmation)|Confirm\? |Continue\? \[|Trust this (folder|workspace|directory))'

declare -A seen   # "source__id" → 1

# Deterministic, collision-free key for pane ids: sha256 of the raw pane id.
_pane_key() { printf '%s' "$1" | sha256sum | cut -c1-16; }

# Untrusted terminal text / pane titles must never carry control characters,
# tabs, or newlines into record fields. Cap length while we're at it.
_clean_field() { printf '%s' "$1" | tr -d '\t\r\n\000' | tr -c '[:print:]' '_' | cut -c1-160; }

# ---------- 1. herdr native "blocked" ----------
if command -v herdr >/dev/null 2>&1 && herdr status server >/dev/null 2>&1; then
  pane_list="$(herdr pane list 2>/dev/null | jq -r '
      (.result.panes // [])[]
      | [ .pane_id, (.agent // ""), (.agent_status // "unknown"),
          (.terminal_title_stripped // ""), (.cwd // "") ]
      | @tsv' 2>/dev/null)"

  while IFS=$'\t' read -r pane agent status title cwd; do
    [[ -z "$pane" ]] && continue
    if [[ "$status" == "blocked" ]]; then
      # Record filename is keyed on hash(pane); mirror it in `seen`.
      id="$(_pane_key "$pane")"
      seen["herdr__$id"]=1
      agent-approval add herdr "$pane" "$(_clean_field "${agent:-agent} blocked in herdr $pane")" "$(_clean_field "${title:-$cwd}")"
    fi
  done <<<"$pane_list"

  # Fallback text scan, scoped strictly to panes herdr can't classify yet
  # (status == "unknown", e.g. agy, gemini, aider). Agents herdr already
  # classifies natively (claude, codex, etc. -- "working"/"idle"/"blocked")
  # must skip this: free-text grepping a working pane's own scrollback (which
  # can legitimately contain words like "approval" or "waiting for input",
  # e.g. Claude discussing this very script) produces false positives.
  while IFS=$'\t' read -r pane agent status; do
    [[ -z "$pane" || -z "$agent" || "$status" != "unknown" ]] && continue
    tail_text="$(herdr pane read "$pane" --lines 25 2>/dev/null | jq -r '.result.text // .result.output // empty' 2>/dev/null)"
    [[ -z "$tail_text" ]] && continue
    if grep -qiE "$PROMPT_RE" <<<"$tail_text"; then
      match="$(grep -iE "$PROMPT_RE" <<<"$tail_text" | tail -1 | head -c 160)"
      seen["herdr__$(_pane_key "$pane")"]=1
      agent-approval add herdr "$pane" "$(_clean_field "${agent} waiting for input in herdr $pane")" "$(_clean_field "$match")"
    fi
  done <<<"$pane_list"
fi

# ---------- 2. tmux text scan ----------
if command -v tmux >/dev/null 2>&1 && tmux list-sessions >/dev/null 2>&1; then
  while IFS=$'\t' read -r pane cmd title; do
    [[ -z "$pane" ]] && continue
    # Only look at panes running something agent-ish, not idle shells.
    # NOTE: this is a process-name allowlist, not proof of agency — a user's
    # own interactive python session asking "[y/N]" would also match.
    case "$cmd" in
      claude|codex|opencode|gemini|aider|agy|hermes|node|python*|bun|deno|cursor-agent|goose|amp) ;;
      *) continue ;;
    esac
    tail_text="$(tmux capture-pane -p -t "$pane" -S -25 2>/dev/null)"
    if grep -qiE "$PROMPT_RE" <<<"$tail_text"; then
      match="$(grep -iE "$PROMPT_RE" <<<"$tail_text" | tail -1 | head -c 160)"
      seen["tmux__$(_pane_key "$pane")"]=1
      agent-approval add tmux "$pane" "$(_clean_field "$cmd waiting for input in tmux $pane")" "$(_clean_field "$match")"
    fi
  done < <(tmux list-panes -a -F $'#{session_name}:#{window_index}.#{pane_index}\t#{pane_current_command}\t#{pane_title}' 2>/dev/null)
fi

# ---------- reconcile + stale sweep: own ONLY herdr/tmux records ----------
# Files are named <src>__<hash16(raw id)>; when a record's file is gone or
# stale (>6h), delete it directly. Foreign sources (hermes-*, claude-code,
# codex, manual) are never touched — the header promises exactly that.
for f in "$STATE_DIR"/herdr__*.json "$STATE_DIR"/tmux__*.json; do
  [[ -e "$f" ]] || continue
  key="$(basename "$f" .json)"
  case "$key" in herdr__*|tmux__*) ;; *) continue ;; esac
  if [[ -z "${seen[$key]:-}" ]]; then
    rm -f -- "$f"
  fi
done
find "$STATE_DIR" \( -name 'herdr__*.json' -o -name 'tmux__*.json' \) -mmin +360 -print0 2>/dev/null \
| while IFS= read -r -d '' f; do
  rm -f -- "$f"
done

exit 0
